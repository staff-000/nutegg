{
  "name": "nutegg",
  "private": true,
  "workspaces": [
    "shared",
    "chrome-extension",
    "obsidian-plugin",
    "website"
  ],
  "scripts": {
    "models:update": "byokit build shared/byok.config.json --out shared/generated/models.mjs --compact",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prelint": "npm run models:update",
    "lint": "node scripts/lint.js",
    "format": "node scripts/format.js",
    "format:check": "node scripts/format.js --check",
    "dev:plugin": "npm run dev --workspace=@nutegg/obsidian-plugin",
    "build:plugin": "npm run build --workspace=@nutegg/obsidian-plugin",
    "test:plugin": "npm run test --workspace=@nutegg/obsidian-plugin",
    "build:extension": "npm run build --workspace=@nutegg/chrome-extension",
    "test:extension": "npm run test --workspace=@nutegg/chrome-extension",
    "build:website": "npm run build --workspace=@nutegg/website",
    "dev:website": "./preview-website.sh",
    "preview:website": "./preview-website.sh",
    "deploy": "./deploy.sh",
    "deploy:remote": "./deploy.sh --remote",
    "release": "./release.sh",
    "update:version": "node scripts/update-download-version.js"
  },
  "devDependencies": {
    "byokit": "latest"
  }
}
